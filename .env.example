# ── AI Models ──────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
WHISPER_MODEL=tiny
EMBEDDING_MODEL=nomic-embed-text

# ── Storage ────────────────────────────────────────────────────────────────
DATA_DIRECTORY=./data

# ── Docker / Remote Ollama ─────────────────────────────────────────────────
# When running locally, leave blank (defaults to http://localhost:11434)
# When running via docker compose, this is set automatically to http://ollama:11434
OLLAMA_HOST=

# ── Frontend (Docker only) ─────────────────────────────────────────────────
# URL the browser uses to reach the backend. Defaults to http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api
